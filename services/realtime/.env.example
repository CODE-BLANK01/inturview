# Copy to .env and fill in. Run from services/realtime:
#   python -m venv .venv && .venv\Scripts\activate   (Windows)
#   pip install -r requirements.txt
#   uvicorn app.main:app --reload --port 8000

# --- OpenAI Realtime ---
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
# Voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_REALTIME_VOICE=marin

# --- Next.js app (server-to-server) ---
NEXTJS_INTERNAL_URL=http://localhost:3000
# Must match REALTIME_SERVICE_SECRET in the Next.js .env.local
REALTIME_SERVICE_SECRET=

# Browser origins allowed to call this service (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# --- Turn detection tuning (the "it hears me breathe" knobs) ---
# semantic_vad (default): the turn ends when the candidate *sounds* finished,
# so thinking pauses mid-answer don't trigger the next question.
# server_vad: fixed silence window + loudness threshold (the RT_VAD_* knobs
# below). More robust to room noise; cuts people off when they pause.
RT_TURN_DETECTION=semantic_vad
# semantic_vad only: low | medium | high | auto. low = most patient.
RT_VAD_EAGERNESS=low
# server_vad threshold: 0.0-1.0. Default OpenAI is 0.5; breathing/keyboard
# noise stops triggering somewhere around 0.7-0.85 with noise reduction on.
RT_VAD_THRESHOLD=0.8
# How long the candidate must be quiet before a turn is committed (ms).
RT_VAD_SILENCE_MS=900
# Audio kept from before speech was detected (ms) so first syllables aren't clipped.
RT_VAD_PREFIX_MS=300
# near_field for headsets/laptops, far_field for conference-room mics.
RT_NOISE_REDUCTION=near_field
# Forcing the transcription language stops noise from being "translated".
RT_INPUT_LANGUAGE=en
RT_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Ephemeral client secret lifetime (seconds). Only needs to cover connect time.
RT_CLIENT_SECRET_TTL=600
