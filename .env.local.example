# Copy to .env.local and fill in real values.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model. Default is claude-sonnet-4-5 (fast + capable).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Supabase Postgres ---
# Get both URLs from Supabase Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL: use the "Connection pooler" (Transaction mode, port 6543) — safe for
# serverless and Next.js API routes.
#   postgres://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# DIRECT_URL: use the "Direct connection" (port 5432). Prisma uses this for migrations
# (db push / migrate dev / migrate deploy). Leaving it empty falls back to DATABASE_URL.
#   postgres://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Optional: used to encrypt TOTP secrets at rest. Falls back to NEXTAUTH_SECRET
# if unset. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Admin ---
# Comma-separated emails. These accounts are auto-promoted to ADMIN on signup AND signin.
# Sign out and back in after changing this so the new role lands in your session token.
ADMIN_EMAILS=you@example.com

# --- Email (Resend) — used for password reset links ---
# Get a key at https://resend.com/api-keys. Leave blank in dev — reset links
# will be logged to the server console instead of sent.
RESEND_API_KEY=
# Optional. For dev/testing without a verified sending domain, leave blank
# (defaults to "inturview <onboarding@resend.dev>"). For production, set to
# your verified domain: "inturview <hello@yourdomain.com>".
RESEND_FROM=

# --- Rate limits (per IP, in-memory; see lib/rateLimit.ts) ---
RL_MESSAGE_PER_MIN=20
RL_DEBRIEF_PER_MIN=10
RL_SIGNUP_PER_HOUR=10
RL_FORGOT_PASSWORD_PER_HOUR=5
RL_RESET_PASSWORD_PER_HOUR=20
# Sign-in rate limits — first one is per (IP + email), tight; second is per IP
# across all emails (catches distributed guessing from a single host).
RL_SIGNIN_PER_15MIN=10
RL_SIGNIN_IP_PER_HOUR=50
# Anti email-bombing: per-destination-email caps. These buckets are shared
# across all source IPs, so a proxy pool can't multiply emails to one victim.
RL_SIGNUP_TARGET_PER_HOUR=3
RL_FORGOT_TARGET_PER_HOUR=3
