// Prisma schema for inturview
// Postgres + Prisma. Single-source-of-truth for users, problems, and interview history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // If you switch DATABASE_URL to a pooler (e.g. Supabase port 6543), uncomment the
  // line below and set DIRECT_URL to the direct connection (port 5432) for migrations:
  // directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
  TEAM_STARTER
  TEAM_GROWTH
  ENTERPRISE
}

enum OnboardingGoal {
  PRACTICING
  RECRUITING
  COACHING
  EXPLORING
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  role         Role        @default(USER)
  plan         PlanTier    @default(FREE)
  goal         OnboardingGoal?
  /// Non-null once the user clicks the verification link from their inbox.
  /// Authenticated requests are routed to /verify-email until this is set.
  emailVerifiedAt DateTime?
  /// Non-null once the user finishes the onboarding wizard. Until then, any
  /// authenticated request that lands on /dashboard etc. is redirected back
  /// to /onboarding.
  onboardingCompletedAt DateTime?
  /// Monotonic counter bumped to revoke every outstanding JWT for this user
  /// (password change, role change, disable, manual "sign out everywhere").
  /// The signed JWT carries the value at issue time; requireUser() compares
  /// it to the current DB value on every protected request.
  tokenVersion Int @default(0)
  /// Non-null when TOTP MFA is enabled for the user.
  totpEnabledAt DateTime?
  /// AES-GCM encrypted TOTP secret. Null until the user completes setup.
  totpSecret String?
  /// Bcrypt hashes of one-time recovery codes. Stored as JSON string array.
  totpRecoveryCodes Json?
  flagged      Boolean     @default(false)
  flagReason   String?
  // Non-null = the user is disabled and can't sign in. Existing data is retained.
  disabledAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  interviews   Interview[]
  designSessions DesignSession[]
  auditEntries AuditLog[]  @relation("AdminAudit")
  resetTokens  PasswordResetToken[]
  verificationTokens EmailVerificationToken[]

  @@index([role])
  @@index([flagged])
  @@index([plan])
  @@index([emailVerifiedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  /// SHA-256 hash of the raw token — the raw token only lives in the email link.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  // SHA-256 hash of the raw token — the raw token only ever lives in the email link.
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminAudit", fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([adminId])
  @@index([action])
}

model Problem {
  // id is the human-readable slug ("two-sum"), mirroring lib/problems.ts.
  id           String      @id
  title        String
  difficulty   String
  topic        String
  leetcodeUrl  String
  description  String
  examples     Json
  constraints  Json
  optimalTime  String
  optimalSpace String
  tags         Json
  interviews   Interview[]

  @@index([topic])
  @@index([difficulty])
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Interview {
  id             String          @id @default(cuid())
  userId         String
  problemId      String
  status         InterviewStatus @default(IN_PROGRESS)
  language       String          @default("python")
  code           String          @default("")
  totalScore     Int?
  recommendation String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  // First time the interviewer emitted [READY] for this candidate's approach.
  // null when the candidate jumped to code without the interviewer signaling acceptance —
  // weighted negatively in the debrief's communication / approach_quality scores.
  approachAcceptedAt DateTime?
  // Whether the candidate clicked "Start coding" while the latest interviewer
  // signal was still [CONTINUE]. Persisted for the debrief.
  movedToCodeEarly   Boolean   @default(false)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem  Problem   @relation(fields: [problemId], references: [id])
  messages Message[]
  debrief  Debrief?

  @@index([userId, problemId, completedAt])
  @@index([userId, startedAt])
}

model Message {
  id          String   @id @default(cuid())
  interviewId String
  phase       String
  role        String
  content     String
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
}

model Debrief {
  id          String   @id @default(cuid())
  interviewId String   @unique
  payload     Json
  totalScore  Int
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// System-design interviews — parallel surface to coding (Problem/Interview).
// Separate models because the field shapes are mostly disjoint (no LeetCode
// URL, no optimal_time/space; instead: open prompt, reference architecture,
// canvas JSON snapshot).
// ---------------------------------------------------------------------------

model SystemDesignProblem {
  // Slug ("design-twitter"), mirrors Problem.id convention.
  id                       String   @id
  title                    String
  difficulty               String   // Easy / Medium / Hard
  topic                    String   // Feeds, Messaging, Storage, Geospatial, ...
  /// The open prompt the AI delivers at session start.
  prompt                   String
  /// JSON: { functional: string[], nonFunctional: string[] } — used as
  /// reference during debrief grading, not shown to the candidate live.
  expectedRequirements     Json
  /// Plain-text canonical architecture summary (multi-paragraph) used in
  /// the debrief's "optimal solution notes" and as grading reference.
  referenceArchitecture    String
  /// JSON string[] — suggested deep-dive topics the AI can probe.
  deepDiveTopics           Json
  estimatedDurationMinutes Int      @default(45)

  sessions DesignSession[]

  @@index([topic])
  @@index([difficulty])
}

enum DesignSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model DesignSession {
  id              String              @id @default(cuid())
  userId          String
  problemId       String
  status          DesignSessionStatus @default(IN_PROGRESS)
  /// Excalidraw scene JSON (the elements + appState subset we care about).
  /// Debounced auto-save from the client. Null at session start.
  canvasJson      Json?
  totalScore      Int?
  recommendation  String?
  startedAt       DateTime            @default(now())
  completedAt     DateTime?
  /// First time the interviewer emitted [SCOPED] for this session's requirements.
  /// Null when the candidate moved to design without scope acceptance —
  /// caps the Requirements/Architecture scores in debrief.
  scopeAcceptedAt DateTime?
  /// Whether the candidate clicked "Start designing" while the latest signal
  /// was still [CONTINUE]. Behavioral signal feeding the rubric.
  movedToDesignEarly Boolean          @default(false)

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem  SystemDesignProblem @relation(fields: [problemId], references: [id])
  messages DesignMessage[]
  debrief  DesignDebrief?

  @@index([userId, problemId, completedAt])
  @@index([userId, startedAt])
}

model DesignMessage {
  id        String   @id @default(cuid())
  sessionId String
  /// "scope" | "design" | "debrief" (debrief = post-debrief follow-up chat)
  phase     String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  session DesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model DesignDebrief {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  payload    Json
  totalScore Int
  createdAt  DateTime @default(now())

  session DesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
