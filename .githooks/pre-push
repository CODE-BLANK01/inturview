#!/bin/sh
# GitHub's free plan can't protect branches on a private repo, so this hook
# does it locally: work reaches main and dev through pull requests only.
# Emergency override: ALLOW_DIRECT_PUSH=1 git push ...

[ "$ALLOW_DIRECT_PUSH" = "1" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/dev)
      branch=${remote_ref#refs/heads/}
      echo "✗ Direct pushes to '$branch' are off. Push a branch and open a pull request:"
      echo "    git switch -c feat/your-change && git push -u origin HEAD"
      echo "  Emergency only: ALLOW_DIRECT_PUSH=1 git push ..."
      exit 1
      ;;
  esac
done
exit 0
